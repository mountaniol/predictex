# Question Creator Environment Variables

# Override the API base URL (optional)
# Use this when your backend is accessible via a different URL
# Examples:
# - For local development: http://localhost:3004
# - For HTTPS with proxy: https://your-domain.com/api-creator
# - For direct HTTPS backend: https://your-domain.com:3004
# REACT_APP_API_BASE_URL=

# Port for development server (default: 3003)
PORT=3003

# Other React app settings
# REACT_APP_DEBUG=true